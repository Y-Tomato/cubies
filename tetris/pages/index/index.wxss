.page {
  min-height: 100vh;
  position: relative;
}

.content {
  padding: 48rpx 40rpx 60rpx;
  max-width: 560px;
  margin: 0 auto;
  box-sizing: border-box;
}

.hero {
  text-align: center;
  margin: 40rpx 0 48rpx;
}

.logo {
  font-size: 96rpx;
}

.title {
  display: block;
  font-size: 80rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  margin-top: 8rpx;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  letter-spacing: 8rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 8rpx;
}

.start-btn {
  margin-bottom: 32rpx;
  padding: 30rpx 0;
  text-align: center;
  background: #4da3ff;
  color: #081018;
  font-size: 36rpx;
  font-weight: 800;
  border-radius: 48rpx;
}

.start-btn-hover {
  opacity: 0.85;
}

.panel {
  background: rgba(20, 24, 50, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4da3ff;
  margin-bottom: 16rpx;
}

.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.setting-row + .setting-row {
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.setting-title {
  font-size: 30rpx;
}

.setting-desc {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  margin-top: 6rpx;
}

.hint-line {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
  line-height: 2;
}

.tip {
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 12rpx;
}
