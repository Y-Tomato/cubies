.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 16rpx;
  background: #1a2233;
  border-bottom: 1rpx solid #2a3550;
}

.tbtn {
  min-width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.06);
}

.tbtn-hover {
  background: rgba(77, 163, 255, 0.28);
}

.score-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: 1.15;
}

.score {
  font-size: 40rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.meta {
  font-size: 20rpx;
  color: #8896b0;
}

.board-area {
  flex: 1;
  min-height: 0;
  position: relative;
  margin: 8rpx;
  background: #1a2233;
  border: 1rpx solid #2a3550;
  border-radius: 10rpx;
  overflow: hidden;
}

.board-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.preview-bar {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  gap: 40rpx;
  padding: 8rpx 0 4rpx;
}

.preview {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.preview-label {
  font-size: 20rpx;
  color: #8896b0;
  margin-bottom: 6rpx;
}

.mini {
  background: rgba(0, 0, 0, 0.25);
  border-radius: 6rpx;
}

.mini.next {
  width: 120rpx;
  height: 120rpx;
}

.mini.hold {
  width: 120rpx;
  height: 60rpx;
}

.controls {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 24rpx 24rpx;
}

.cluster {
  display: flex;
  gap: 16rpx;
}

.cbtn {
  width: 104rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  background: #1a2233;
  border: 1rpx solid #2a3550;
  border-radius: 14rpx;
}

.cbtn-hover {
  background: #2a3550;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-card {
  width: 78%;
  max-width: 420px;
  background: #1d2440;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  text-align: center;
}

.modal-emoji {
  font-size: 88rpx;
  display: block;
}

.modal-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  margin-top: 16rpx;
}

.modal-sub {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 16rpx;
}

.modal-btns {
  display: flex;
  margin-top: 40rpx;
}

.btn {
  flex: 1;
  padding: 22rpx 0;
  border-radius: 40rpx;
  background: #4da3ff;
  color: #081018;
  font-size: 30rpx;
  font-weight: 700;
}

.btn-hover {
  opacity: 0.85;
}

.btn.ghost {
  background: rgba(255, 255, 255, 0.1);
  color: #ffffff;
  margin-left: 20rpx;
}
